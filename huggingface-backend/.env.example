# =========================================================
# Hugging Face Backend - Environment Variables
# Copy to .env and fill values, or set as Space Secrets
# =========================================================

# Server
PORT=7860
NODE_ENV=production

# Security (must match Hostinger config/app.php)
API_KEY=change-this-strong-random-key
WEBHOOK_SECRET=change-this-strong-random-secret

# Hostinger webhook receiver (full URL to webhook.php)
HOSTINGER_WEBHOOK_URL=https://yourdomain.com/webhook.php

# CORS (comma-separated list of dashboard origins)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session storage path (HF persistent /data mount recommended)
SESSION_PATH=/data/wa_session

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Queue defaults
DEFAULT_MIN_DELAY_MS=120000
DEFAULT_MAX_DELAY_MS=300000

# WhatsApp client
WA_CLIENT_ID=primary

# Logs
LOG_LEVEL=info
